# RealDeal Cloud Functions - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ============================================
# REQUIRED - Core API Keys
# ============================================

# RapidAPI Key (for Zillow and Redfin APIs)
# Get from: https://rapidapi.com/developer/dashboard
# Subscribe to:
#   - real-time-real-estate-data.p.rapidapi.com (property search + details)
#   - redfin-com.p.rapidapi.com (comps)
RAPID_API_KEY=your_rapidapi_key_here

# Stripe Secret Key (for payments)
# Get from: https://dashboard.stripe.com/apikeys
# Use TEST key (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# HubSpot API Key (for CRM integration)
# Get from: https://app.hubspot.com/api-key
HUBSPOT_API_KEY=your_hubspot_api_key_here

# SendGrid API Key (for email delivery)
# Get from: https://app.sendgrid.com/settings/api_keys
# Verify sender: deals@getrealdeal.ai
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ============================================
# REQUIRED - Google Analytics 4
# ============================================

# GA4 Property ID (numeric ID, not measurement ID)
# Find in GA4: Admin > Property Settings
GA4_PROPERTY_ID=123456789

# Path to GA4 service account JSON key file
# Create in Google Cloud Console: IAM > Service Accounts
# Grant role: "Viewer" on GA4 property
GA4_SERVICE_ACCOUNT_PATH=./service-account-ga4.json

# ============================================
# OPTIONAL - Feature Flags
# ============================================

# Enable/disable specific features
ENABLE_ZILLOW_API=true
ENABLE_REDFIN_API=true
ENABLE_HUBSPOT_SYNC=true
ENABLE_GA4_TRACKING=true
