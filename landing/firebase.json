{
  "hosting": {
    "site": "getrealdeal-landing",
    "public": "habu-proxy-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "habu-service",
          "region": "us-west1"
        }
      }
    ]
  }
}
